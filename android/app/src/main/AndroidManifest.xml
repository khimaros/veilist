<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- the camera plugin declares permissions for video recording and legacy
         gallery writes. the qr scanner only previews and decodes frames (the
         camera is opened with audio disabled), so drop them: a list app has no
         business asking for a microphone or the photo library. READ_EXTERNAL_
         STORAGE is not declared by any plugin - the manifest merger implies it
         from WRITE_EXTERNAL_STORAGE, so it has to be removed too. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <!-- a device with no camera can still do everything but scan a code, so the
         camera must not gate installation. the plugin declares camera.any as
         required, and the CAMERA permission implies a required android.hardware
         .camera on top of that, so both are declared optional here. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false"
        tools:replace="android:required" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <application
        android:label="veilist"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- singleTask keeps one instance: a veilist:// intent while the app is
             open is delivered to the running engine (onNewIntent -> app_links)
             instead of spawning a second engine that re-runs main() and re-inits
             veilid ("AlreadyInitialized"). an empty taskAffinity defeats that, so
             it is intentionally absent. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- veilist:// share links open directly in the app (R2). the
                 custom scheme needs no domain verification, so it is the
                 reliable deep-link path. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="veilist"/>
            </intent-filter>
            <!-- the http web-fallback url (veilid.tech/list). http app links
                 cannot be auto-verified, so this offers - not forces - opening
                 these links in the app; users without the app get the web
                 fallback in a browser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="http" android:host="veilid.tech" android:pathPrefix="/list"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
