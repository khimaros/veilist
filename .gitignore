# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# veilid wasm blob is built via `make wasm` (scripts/build_wasm.sh)
/web/wasm/

# python e2e artifacts (uv-managed venvs, caches). global patterns so they match
# wherever the suites live under test/e2e/.
**/.venv/
**/.pytest_cache/
**/__pycache__/

# appium ui e2e: local driver home and the npm deps for the appium server
test/e2e/appium/.appium/
test/e2e/appium/node_modules/
